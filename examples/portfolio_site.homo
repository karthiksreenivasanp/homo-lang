create website
set responsive
set theme as dark
set meta title as "karthiksreenivasanp"
set meta description as "Karthik Sreenivasan P - AI and Data Science student building offline AI tools and creative software."

add stylesheet "https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Inter:wght@400;500;600;700;800&display=swap"

set style of body as background:#050b16, color:#ffffff, font-family:Inter, overflow-x:hidden
set style of .homo-content as width:92%, max-width:1150px, margin:auto, padding:40px 0
set style of section as margin-top:60px
set style of #hero as margin-top:0

set style of .readme-box as border:1px solid #2a3344, border-radius:14px, padding:24px, background:#040915
set style of .top-bar as display:flex, justify-content:space-between, align-items:center, color:#d7d7d7, font-size:14px, margin-bottom:30px, font-family:'Fira Code'
set style of .edit-btn as font-size:22px, opacity:0.8
set style of h1 as text-align:center, font-size:6vw, font-weight:800, margin-bottom:20px, color:#e8edf7
set style of .typing as text-align:center, font-family:'Fira Code', font-size:3vw, color:#00ff66, margin-bottom:30px, min-height:40px, font-weight:600
set style of .snake-box img as width:100%, border-radius:10px
set style of .code-box as background:#111827, border:1px solid #1f2a3a, border-radius:16px, padding:30px, overflow:auto, margin-top:20px
set style of .code-box code as font-family:'Fira Code', font-size:15px, line-height:1.8, color:#ffffff, white-space:pre
set style of .button-section as display:flex, justify-content:center, margin-top:30px
set style of .coffee-btn img as transition:0.3s
set style of .coffee-btn img:hover as transform:translateY(-4px)

set style of .about-card as display:flex, justify-content:space-between, align-items:center, gap:40px, background:#040915, border:1px solid #7c3aed, border-radius:14px, padding:32px, flex-wrap:wrap
set style of .about-list as display:flex, flex-direction:column, gap:12px, color:#d6d6d6, font-size:17px, line-height:1.8
set style of .about-image img as width:170px, height:170px, object-fit:cover, border-radius:50%, border:4px solid #111827, box-shadow:0 0 25px #7c3aed

set style of .project-card as background:#111827, border:1px solid #1f2a3a, border-radius:14px, padding:24px, margin-bottom:20px, transition:0.3s
set style of .project-card:hover as transform:translateY(-4px), border-color:#00ff66
set style of .project-card h3 as margin-bottom:12px, font-size:24px
set style of .project-card a as color:#4ea1ff, text-decoration:none
set style of .project-card p as color:#d7d7d7, line-height:1.7, margin-bottom:12px
set style of .tech as color:#00ff99, font-family:'Fira Code'

set style of .connect as text-align:center, margin-top:60px, padding-bottom:40px
set style of .connect h2 as margin-bottom:16px, font-size:28px
set style of .connect a as color:#4ea1ff, text-decoration:none, margin:0 10px, font-size:18px
set style of .connect a:hover as color:#00ff66

