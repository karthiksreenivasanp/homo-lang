show "--- Testing Auto-Cleaning AI Pipeline ---"

load data "dirty_data.csv" as df
show "Here is the messy data we loaded:"
show data df 7 rows

show "Teaching the AI (auto-cleaning will happen here)..."
make AI "forest" as predictor
teach predictor using df to guess "is_sold"

show "Testing the AI on the same messy data..."
test predictor on df as score

show "The Accuracy Score is:"
show score
